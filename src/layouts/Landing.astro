---
import type { Project } from "../data/projects";
import { projects } from "../data/projects";
import { PAGE_COLOR } from "../data/theme";
import Frame from "../components/Frame.astro";
import Nav from "../components/Nav.astro";
import TitleCard from "../components/TitleCard.astro";
import { withBase } from "../lib/base";

export interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const counter = `project ${index + 1}/${total}`;

// index 0 lives at "/", every other project gets its own "/[slug]" route
const hrefFor = (i: number) => (i === 0 ? "/" : `/${projects[i].slug}`);
const prevIndex = (index - 1 + total) % total;
const nextIndex = (index + 1) % total;
const prevProject = projects[prevIndex];
const nextProject = projects[nextIndex];
---

<Frame background={PAGE_COLOR.about}>
  <div class="content">
    <section class="intro">
      <p>Hi there,</p>
      <p>I'm Michelle and I am an <strong>interaction designer</strong>.</p>
      <p>I make things out of curiosity, and occasionally for my friends.</p>
      <p>Welcome to my portfolio!</p>
    </section>

    <div class="carousel">
      <div class="counter">{counter}</div>

      <img class="hero" src={withBase(project.logo)} alt={project.title} width="400" height="400" />

      <div class="meta">
        <TitleCard
          title={project.title}
          tagline={project.tagline}
          category={project.category}
          titleHref={withBase(`/projects/${project.slug}`)}
        />
      </div>

      <a class="arrow arrow-prev" href={withBase(hrefFor(prevIndex))} aria-label={`Previous project: ${prevProject.title}`}>‹</a>
      <a class="arrow arrow-next" href={withBase(hrefFor(nextIndex))} aria-label={`Next project: ${nextProject.title}`}>›</a>
    </div>
  </div>
</Frame>

<Nav active="about" />

<style>
  /* groups the intro text and the project card so the pair can be centered
     together, instead of each being pinned to its own frame-relative spot */
  .content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 264px;
  }

  /* intro paragraph — identical across all projects */
  .intro {
    width: 480px;
  }

  .intro p {
    margin: 0 0 24px;
    font-size: 32px;
    line-height: 1.3;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .carousel {
    position: relative;
    flex: none;
    width: 562px;
    height: 540px;
  }

  .counter {
    position: absolute;
    left: 83px;
    top: 0;
    width: 222px;
    height: 49px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border: 1px solid #000;
    background: #fff;
    font-size: 20px;
  }

  .hero {
    position: absolute;
    left: 83px;
    top: 49px;
    width: 400px;
    height: 400px;
    display: block;
  }

  .meta {
    position: absolute;
    left: 83px;
    top: 468px;
    width: 400px;
  }

  /* carousel controls — identical across all projects */
  .arrow {
    position: absolute;
    top: 480px;
    display: inline-block;
    font-size: 72px;
    font-weight: 300;
    line-height: 1;
    color: #000;
    text-decoration: none;
    /* squash the ‹ › glyphs vertically and stretch them horizontally so the
       chevron shape reads more clearly at a glance */
    transform: scale(1.8, 0.55);
  }

  .arrow-prev {
    left: 0;
  }

  .arrow-next {
    right: 0;
  }
</style>
