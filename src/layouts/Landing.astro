---
import type { Project } from "../data/projects";
import { projects } from "../data/projects";
import { PAGE_COLOR } from "../data/theme";
import Frame from "../components/Frame.astro";
import Nav from "../components/Nav.astro";
import TitleCard from "../components/TitleCard.astro";
import { withBase } from "../lib/base";

export interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const counter = `project ${index + 1}/${total}`;

// index 0 lives at "/", every other project gets its own "/[slug]" route
const hrefFor = (i: number) => (i === 0 ? "/" : `/${projects[i].slug}`);
const prevIndex = (index - 1 + total) % total;
const nextIndex = (index + 1) % total;
const prevProject = projects[prevIndex];
const nextProject = projects[nextIndex];
---

<Frame background={PAGE_COLOR.about}>
  <div class="content">
    <section class="intro">
      <p>Hi there,</p>
      <p>I'm Michelle and I am an <strong>interaction designer</strong>.</p>
      <p>I make things out of curiosity, and occasionally for my friends.</p>
      <p>Welcome to my portfolio!</p>
    </section>

    <div class="carousel">
      <div class="counter">{counter}</div>

      <img class="hero" src={withBase(project.logo)} alt={project.title} width="400" height="400" />

      <div class="meta">
        <TitleCard
          title={project.title}
          tagline={project.tagline}
          category={project.category}
          titleHref={withBase(`/projects/${project.slug}`)}
        />
      </div>

      <a class="arrow arrow-prev" href={withBase(hrefFor(prevIndex))} aria-label={`Previous project: ${prevProject.title}`}>‹</a>
      <a class="arrow arrow-next" href={withBase(hrefFor(nextIndex))} aria-label={`Next project: ${nextProject.title}`}>›</a>
    </div>
  </div>
</Frame>

<Nav active="about" />

<script define:vars={{ projects, initialIndex: index, base: import.meta.env.BASE_URL }}>
  // Flipping through the carousel swaps the displayed project's content in
  // place instead of navigating to its route, so the URL/tab title stay
  // exactly as they were on load (whichever project you arrived at directly,
  // e.g. via /kone) rather than jumping around between "/", "/kone", "/hesper"
  // as you browse. The server-rendered hrefs above are the no-JS fallback;
  // this just intercepts clicks when JS is available.
  let currentIndex = initialIndex;
  const total = projects.length;

  function withBase(path) {
    return base.replace(/\/$/, "") + path;
  }

  // mirrors Landing.astro's own hrefFor: index 0 lives at "/", every other
  // project gets its own "/[slug]" route
  function hrefFor(i) {
    return i === 0 ? "/" : `/${projects[i].slug}`;
  }

  function render(i) {
    const project = projects[i];
    const prevI = (i - 1 + total) % total;
    const nextI = (i + 1) % total;

    document.querySelector(".carousel .counter").textContent = `project ${i + 1}/${total}`;

    const heroImg = document.querySelector(".carousel .hero");
    heroImg.src = withBase(project.logo);
    heroImg.alt = project.title;

    const titleLink = document.querySelector(".carousel .meta .title a");
    titleLink.textContent = project.title;
    titleLink.href = withBase(`/projects/${project.slug}`);

    document.querySelector(".carousel .meta .tagline").textContent = project.tagline;
    document.querySelector(".carousel .meta .category").textContent = project.category;

    const prevArrow = document.querySelector(".arrow-prev");
    prevArrow.href = withBase(hrefFor(prevI));
    prevArrow.setAttribute("aria-label", `Previous project: ${projects[prevI].title}`);

    const nextArrow = document.querySelector(".arrow-next");
    nextArrow.href = withBase(hrefFor(nextI));
    nextArrow.setAttribute("aria-label", `Next project: ${projects[nextI].title}`);
  }

  document.querySelector(".arrow-prev").addEventListener("click", (e) => {
    e.preventDefault();
    currentIndex = (currentIndex - 1 + total) % total;
    render(currentIndex);
    remember(currentIndex);
  });

  document.querySelector(".arrow-next").addEventListener("click", (e) => {
    e.preventDefault();
    currentIndex = (currentIndex + 1) % total;
    render(currentIndex);
    remember(currentIndex);
  });

  // Remembers whichever project was last shown here, so the root "/" —
  // the nav bar's "projects" destination — can resume there instead of
  // always resetting to Frictionless. /kone and /hesper are each already
  // a specific project's own page (not an ambiguous default), so they
  // always show themselves regardless of what's remembered; only "/"
  // (initialIndex 0) checks it, and only on load — once it's been
  // resolved, this page instance just tracks state like any other.
  const LAST_VIEWED_KEY = "lastViewedProjectSlug";

  function remember(i) {
    try {
      localStorage.setItem(LAST_VIEWED_KEY, projects[i].slug);
    } catch {
      // storage unavailable (private browsing, blocked, etc.) — fine to no-op
    }
  }

  if (initialIndex === 0) {
    let savedSlug = null;
    try {
      savedSlug = localStorage.getItem(LAST_VIEWED_KEY);
    } catch {
      // storage unavailable — just keep the default (Frictionless)
    }
    const savedIndex = projects.findIndex((p) => p.slug === savedSlug);
    if (savedIndex > 0) {
      currentIndex = savedIndex;
      render(currentIndex);
    }
  }

  remember(currentIndex);
</script>

<style>
  /* groups the intro text and the project card so the pair can be centered
     together, instead of each being pinned to its own frame-relative spot */
  .content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 264px;
  }

  /* intro paragraph — identical across all projects */
  .intro {
    width: 480px;
  }

  .intro p {
    margin: 0 0 24px;
    font-size: 32px;
    line-height: 1.3;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .carousel {
    position: relative;
    flex: none;
    width: 562px;
    height: 540px;
  }

  .counter {
    position: absolute;
    left: 83px;
    top: 0;
    width: 222px;
    height: 49px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border: 1px solid #000;
    background: #fff;
    font-size: 20px;
  }

  .hero {
    position: absolute;
    left: 83px;
    top: 49px;
    width: 400px;
    height: 400px;
    display: block;
  }

  .meta {
    position: absolute;
    left: 83px;
    top: 468px;
    width: 400px;
  }

  /* carousel controls — identical across all projects */
  .arrow {
    position: absolute;
    top: 480px;
    display: inline-block;
    font-size: 72px;
    font-weight: 300;
    line-height: 1;
    color: #000;
    text-decoration: none;
    /* squash the ‹ › glyphs vertically and stretch them horizontally so the
       chevron shape reads more clearly at a glance */
    transform: scale(1.8, 0.55);
  }

  .arrow-prev {
    left: 0;
  }

  .arrow-next {
    right: 0;
  }
</style>
