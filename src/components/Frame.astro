---
export interface Props {
  background?: string;
}

const { background = "#fff" } = Astro.props;
---

<div class="viewport" style={`background: ${background};`}>
  <div class="frame" style={`background: ${background};`}>
    <slot />
  </div>
</div>

<style>
  /* fills the browser window and scales the art-directed frame to fit it */
  .viewport {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .frame {
    position: relative;
    flex: none;
    width: 1512px;
    height: 982px;
    color: #000;
    transform: scale(var(--frame-scale, 1));
  }
</style>
